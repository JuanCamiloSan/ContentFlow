# Copia este archivo a infrastructure/.env y completa los valores.
# infrastructure/.env está en .gitignore: nunca lo subas a Git.

POSTGRES_DB=contentplan
POSTGRES_USER=contentplan
# Elige una contraseña propia, por ejemplo: openssl rand -base64 24
POSTGRES_PASSWORD=
# Roles de la aplicación (ADR 0003). Contraseñas distintas entre sí y de la anterior.
# Solo se aplican al crear el volumen; si ya existe: docker compose down -v
CONTENTPLAN_OWNER_PASSWORD=
CONTENTPLAN_APP_PASSWORD=
POSTGRES_PORT=5432

# Google OAuth (ADR 0004, tarea C1). Proyecto de Google Cloud, cliente web, pantalla en modo Prueba.
# El ID de cliente no es secreto: el backend lo usa como audience del token (C2).
GOOGLE_CLIENT_ID=853071431083-c3a2f176tc2b11h3j15gln3hvbe5fo42.apps.googleusercontent.com
# El secreto de cliente solo lo necesita el frontend (Auth.js, tarea G1). Va en apps/web/.env.local,
# que está en .gitignore. No lo pongas aquí ni en ningún archivo versionado.
